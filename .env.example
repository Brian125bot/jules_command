# Jules RepoMission Studio - Environment Configuration
# Copy this file to .env or configure these variables in your deployment environment.

# ==========================================
# 1. AI & LLM PROVIDER (Required for Planning & Verification)
# ==========================================
# Google Gemini API Key: Required for server-side task decomposition, 
# chain-of-thought verification, and automated repair synthesis.
# Obtain your key at: https://aistudio.google.com/ or Google Cloud Vertex AI
GEMINI_API_KEY=""

# Optional: Default Gemini model (default: gemini-3.7-flash)
# GEMINI_MODEL="gemini-3.7-flash"

# ==========================================
# 2. HOSTING & NETWORKING (Optional)
# ==========================================
# PORT: Application listening port (default: 3000)
PORT=3000

# APP_URL: Publicly accessible URL for reverse proxies, OAuth callbacks, or webhooks
# APP_URL="http://localhost:3000"

# NODE_ENV: Set to 'production' for live deployment builds
# NODE_ENV="development"

# ==========================================
# 3. GITHUB & JULES CREDENTIALS (Optional Server Fallbacks)
# ==========================================
# Note: Users can provide their personal GitHub Token and Jules API Key directly
# in the application UI (Settings / Header). If defined below, these serve as default fallbacks.
# GITHUB_TOKEN=""
# JULES_API_KEY=""
# JULES_BASE_URL="https://api.jules.ai/v1"
